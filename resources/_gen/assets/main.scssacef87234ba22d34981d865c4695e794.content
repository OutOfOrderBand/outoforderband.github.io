body,
html {
  height: 100%;
  background-color: #c62129;
  color: #fff;
  text-size-adjust: none;
  font-family: "Roboto", Arial, Helvetica, sans-serif;
}

a {
  color: rgb(85%, 85%, 85%);
  text-decoration: none;
  transition: color 0.2s;
}
a:hover {
  color: white;
  text-decoration: underline;
}
a:visited {
  color: rgb(85%, 85%, 85%);
}

.button,
button,
input[type=button],
input[type=reset],
input[type=submit] {
  background-color: #000;
  border: 0.1rem solid #fff;
}

.ns-h1 {
  font-size: 2em;
}

.ns-h4 {
  color: #000;
}

.post-title {
  font-size: 20px;
  margin: 0 0 5px 0;
}

.post-summary {
  font-size: 18px;
}

.notloaded {
  opacity: 0;
  transform: scale(0.9);
}

.loaded {
  background: none;
  opacity: 1;
  transform: scale(1);
  transition: all 400ms ease-in;
}
@media screen and (prefers-reduced-motion: reduce) {
  .loaded {
    transition: none;
  }
}

.pie {
  -webkit-tap-highlight-color: transparent;
  background: #000;
  border-radius: 50%;
  box-shadow: 0 0 4px 5px rgba(0, 0, 0, 0.2);
  cursor: pointer;
  height: 400px;
  left: -200px;
  position: absolute;
  top: -200px;
  width: 400px;
  transform: translateX(-200px) translateY(-200px);
  transition: transform 300ms;
  z-index: 1;
}

.pie-color:hover {
  opacity: 0.85;
}

.pie-color:active {
  opacity: 0.7;
}

.pie1 {
  clip-path: polygon(200px 200px, 344px 450px, 0 450px);
  transition-delay: 30ms;
}

.pie2 {
  clip-path: polygon(200px 200px, 344px 450px, 450px 344px);
  transition-delay: 60ms;
}

.pie3 {
  clip-path: polygon(200px 200px, 450px 0, 450px 344px);
  transition-delay: 90ms;
}

.pie-color {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.pie-color-hyperlink {
  font-size: 1.6rem;
  letter-spacing: 0.03em;
  text-shadow: 1px 1px #000;
  font-weight: 700;
  color: #fff;
}

.pie-color1 {
  background: linear-gradient(135deg, #c62129, #c62129);
  clip-path: polygon(200px 200px, 344px 450px, 0 450px);
}

.pie-color2 {
  background: linear-gradient(135deg, #fff, #fff);
  clip-path: polygon(200px 200px, 344px 450px, 450px 344px);
}

.pie-color3 {
  background: linear-gradient(135deg, #c62129, #c62129);
  clip-path: polygon(200px 200px, 450px 0, 450px 344px);
}

.videos {
  left: 208px;
  position: absolute;
  top: 320px;
  width: 46px;
  transform: rotate(77deg);
}

.gigging {
  left: 272px;
  position: absolute;
  top: 279px;
  width: 46px;
  transform: rotate(46deg);
  color: #c62129;
}

.contact {
  left: 304px;
  position: absolute;
  top: 220px;
  width: 46px;
  transform: rotate(16deg);
}

.main-menu {
  -webkit-tap-highlight-color: transparent;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 0 4px 5px rgba(0, 0, 0, 0.2);
  cursor: pointer;
  height: 200px;
  left: -100px;
  position: absolute;
  top: -100px;
  width: 200px;
  z-index: 1;
}

.hamburger {
  cursor: pointer;
  height: 46px;
  left: 58%;
  position: relative;
  top: 58%;
  width: 46px;
}

.hamburger path {
  transition: transform 300ms;
}

.hamburger path:nth-child(1) {
  transform-origin: 25% 29%;
}

.hamburger path:nth-child(2) {
  transform-origin: 50% 50%;
}

.hamburger path:nth-child(3) {
  transform-origin: 75% 72%;
}

.hamburger path:nth-child(4) {
  transform-origin: 75% 29%;
}

.hamburger path:nth-child(5) {
  transform-origin: 25% 72%;
}

.active .pie {
  transform: translateX(0) translateY(0);
}

.active .hamburger path:nth-child(1) {
  transform: rotate(45deg);
}

.active .hamburger path:nth-child(2) {
  transform: scaleX(0);
}

.active .hamburger path:nth-child(3) {
  transform: rotate(45deg);
}

.active .hamburger path:nth-child(4) {
  transform: rotate(-45deg);
}

.active .hamburger path:nth-child(5) {
  transform: rotate(-45deg);
}

.hero-image {
  background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("/img/BandHeader.jpg?v=fingerprint");
  height: 50%;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  position: relative;
}

.webp .hero-image {
  background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("/img/BandHeader.webp?v=fingerprint");
  height: 40%;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  position: relative;
}

.avif .hero-image {
  background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("/img/BandHeader.avif?v=fingerprint");
  height: 50%;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  position: relative;
}

.hero-text {
  text-align: center;
  position: absolute;
  left: 50%;
  transform: translate(-50%, -50%);
  top: 50%;
}
@media (min-width: 768px) {
  .hero-text {
    top: 60%;
  }
}
@media (min-width: 1367px) {
  .hero-text {
    width: 40%;
  }
}
@media (min-width: 1024px) and (max-width: 1366px) and (orientation: portrait) {
  .hero-text {
    width: 80%;
  }
}
@media (min-width: 1024px) and (max-width: 1366px) and (orientation: landscape) {
  .hero-text {
    width: 40%;
  }
}
@media (max-width: 1023px) and (orientation: portrait) {
  .hero-text {
    width: 80%;
  }
}
@media (max-width: 1023px) and (orientation: landscape) {
  .hero-text {
    width: 50%;
  }
}

.ns-tagline {
  padding-top: 25px;
  padding-left: 15px;
  padding-right: 15px;
  margin: auto;
  max-width: 800px;
  position: relative;
  text-align: center;
  letter-spacing: 0.1em;
  font-family: "Sedgwick Ave Display", cursive;
  font-size: 2.1em;
}

.ns-social {
  padding-top: 8px;
  padding-left: 15px;
  padding-right: 15px;
  margin: auto;
  max-width: 800px;
  position: relative;
  text-align: center;
  z-index: 10;
}

.ns-social a {
  text-decoration: none;
}

.ns-contact-shell,
.ns-setlist-shell,
.ns-404 {
  margin: auto;
  max-width: 700px;
  padding: 15px;
}

.ns-contact,
.ns-setlist {
  padding: 15px;
  background-color: #fff;
  position: relative;
  text-align: center;
  margin-bottom: 50px;
  box-shadow: 0px 10px 52px -12px rgba(0, 0, 0, 0.75);
}
.ns-contact ul,
.ns-setlist ul {
  list-style: none;
  padding-left: 0;
}
.ns-contact li,
.ns-setlist li {
  margin-bottom: 10px;
}
.ns-contact [class^=icon],
.ns-setlist [class^=icon] {
  width: 15px;
  height: 15px;
}

.ns-contact-details,
.ns-setlist-details {
  font-size: 1.4em;
  color: #000;
  text-shadow: 1px 4px 7px rgba(198, 33, 41, 0.38);
}

.ns-contact a,
.ns-contact a:visited {
  color: #c62129;
}

.ns-contact a:hover {
  color: rgb(15%, 15%, 15%);
}

.ns-h1-contact,
.ns-h1-setlist {
  color: #c62129;
}

.ns-gigs {
  padding: 15px;
  margin: auto;
  max-width: 100%;
  position: relative;
  text-align: center;
}
.ns-gigs ul {
  list-style-type: none;
  font-size: 1.1em;
}

.ns-nextgig::before {
  content: "🎸";
}

.ns-nextgig {
  text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #c62129;
  font-size: 1.3em;
}

.ns-nextgig::after {
  content: " (next gig)";
  font-size: 0.9em;
}

hr {
  max-width: 80%;
  margin: 13px auto;
  padding: 0;
  text-align: center;
  border-radius: 5px;
  box-shadow: 0 0 13px #fff;
}

.ns-strikethrough {
  text-decoration: line-through;
  color: rgb(70%, 70%, 70%);
}
.ns-strikethrough a {
  color: rgb(70%, 70%, 70%);
}
.ns-strikethrough a:hover {
  color: white;
}

.ns-setlist-popup {
  color: #000;
}

.gallery {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.video-thumbnail {
  position: relative;
  display: inline-block;
  cursor: pointer;
  margin: 0px 30px 5px 30px;
  max-width: 250px;
}
.video-thumbnail img {
  box-shadow: 10px 10px 42px -4px rgba(0, 0, 0, 0.75);
}
.video-thumbnail:before {
  position: absolute;
  top: 55%;
  left: 50%;
  transform: translate(-50%, -50%);
  -webkit-transform: translate(-50%, -50%);
  opacity: 0.8;
  text-shadow: 0px 0px 30px rgba(0, 0, 0, 0.5);
  z-index: 1;
}

.NSPlay {
  background-image: url(/img/play.svg);
  background-repeat: no-repeat;
  width: 30%;
  height: 30%;
  position: absolute;
  left: 0%;
  right: 0%;
  top: 0%;
  bottom: 0%;
  margin: auto;
  background-size: contain;
  background-position: center;
  z-index: 10;
}

.ns-button,
.speech-bubble {
  position: relative;
  text-align: center;
  margin: auto;
  max-width: 250px;
  background: #000;
  border-radius: 0.4em;
  z-index: 10;
  color: #fff;
}
.ns-button:hover, .ns-button:visited, .ns-button:active,
.speech-bubble:hover,
.speech-bubble:visited,
.speech-bubble:active {
  color: #fff;
}

.speech-bubble:after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 0;
  border: 1em solid transparent;
  border-top-color: #000;
  border-bottom: 0;
  border-left: 0;
  margin-left: -0.5em;
  margin-bottom: -1em;
}

footer {
  position: fixed;
  color: #fff;
  height: 45px;
  background-color: #000;
  bottom: 0px;
  text-align: center;
  width: 100%;
  z-index: 9999;
}
footer p {
  padding-top: 8px;
}

.site-footer {
  margin-top: 35px;
}

.ns-linktree-btn {
  background-color: #000;
  border: 1px solid #000;
  text-transform: lowercase;
  border-radius: 8px;
  font-size: 1.2em;
  line-height: 1em;
  padding-top: 12px;
}
.ns-linktree-btn:hover {
  background-color: #000;
}

.post-list {
  margin: 0;
  padding: 0;
}

.post-list-item {
  border: 1px solid #222;
  margin: 10px 0;
  padding: 10px;
  background: #fff;
}

.post-meta {
  color: #888;
  font-size: 14px;
  margin-bottom: 8px;
}
.post-meta span {
  margin-right: 10px;
}

@media (max-width: 767px) {
  .main-menu-desktop {
    display: none !important;
  }
  .main-menu {
    display: flex !important;
  }
}
@media (min-width: 768px) {
  .main-menu {
    display: none !important;
  }
}
.main-menu-desktop {
  width: 100%;
  background: #000;
  padding: 0;
  margin: 0;
  display: flex;
  justify-content: center;
}

.main-menu-desktop-list {
  display: flex;
  justify-content: center;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0;
}

.main-menu-desktop-list li {
  margin: 0 2rem;
}

.main-menu-desktop-link {
  display: block;
  padding: 1.2rem 1.2rem;
  color: #fff;
  text-decoration: none;
  letter-spacing: 0.1em;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  font-size: 1.4em;
  border-radius: 8px;
  position: relative;
  transition: color 0.2s, background 0.2s, transform 0.2s, box-shadow 0.2s;
  overflow: hidden;
}
.main-menu-desktop-link:after {
  content: "";
  display: block;
  position: absolute;
  left: 20%;
  right: 20%;
  bottom: 10px;
  height: 4px;
  background: linear-gradient(90deg, #c62129 0%, #fff 100%);
  border-radius: 2px;
  transform: scaleX(0);
  transition: transform 0.3s cubic-bezier(0.4, 2, 0.6, 1);
}
.main-menu-desktop-link:hover, .main-menu-desktop-link:focus {
  color: #000;
  background: linear-gradient(90deg, rgb(60.5042016807%, 10.0840336134%, 12.5286478228%) 0%, #c62129 100%);
  text-decoration: none;
  outline: none;
  transform: scale(1.08) rotate(-2deg);
  box-shadow: 0 4px 24px -8px #c62129, 0 2px 8px 0 rgba(0, 0, 0, 0.12);
}
.main-menu-desktop-link:hover:after, .main-menu-desktop-link:focus:after {
  transform: scaleX(1);
}

.ns-notpassed.gig-item {
  transition: background 0.3s, color 0.3s;
  border-radius: 8px;
  margin-bottom: 1rem;
  font-size: 1.1em;
  width: 100%;
}